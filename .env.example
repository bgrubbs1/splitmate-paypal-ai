# SplitMate configuration.
# Copy this file to `.env` and fill in what you need. `.env` is gitignored.
#
# Mock mode is the default: with everything blank below, SplitMate runs fully
# offline with a deterministic AI parser and an offline PayPal stand-in.

# auto  = use the real PayPal sandbox if credentials exist, real LLM if LLM_API_KEY exists
# mock  = force everything offline (best for judges / no accounts)
# real  = require PayPal sandbox credentials; real LLM iff LLM_API_KEY is set
SPLITMATE_MODE=auto

# Where the app runs. Keep 127.0.0.1 for local demos.
SPLITMATE_HOST=127.0.0.1
SPLITMATE_PORT=8000

# Public URL used for PayPal return_url / cancel_url and mock checkout links.
# Must be reachable by the browser that completes the sandbox checkout.
# For a local demo on the same machine, http://127.0.0.1:8000 works.
SPLITMATE_PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- PayPal Developer platform (sandbox) =====================================
# https://developer.paypal.com/dashboard/applications/sandbox
# Create an app, copy its Client ID and Secret here. Sandbox only!
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# Classic `application_context` redirect flow is the default (most compatible).
# Set to 1 to instead send return/cancel URLs under
# payment_source.paypal.experience_context (newer schema placement).
# See RULES-NOTES.md for the verified source and UNVERIFIED caveat.
PAYPAL_EXPERIENCE_CONTEXT=0

# --- AI (optional; any OpenAI-compatible Chat Completions endpoint) ==========
# Example: OpenAI (default base URL + gpt-4o-mini), or a local Ollama shim.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
